# ─── Server ───────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labcontrol

# ─── CORS ─────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
JWT_SECRET="put_your_secret_here"

# ─── Supabase Storage (Opcional - para persistência em nuvem / Render) ───
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_ITEMS=items
